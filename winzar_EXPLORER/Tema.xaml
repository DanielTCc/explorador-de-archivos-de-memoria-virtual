<!-- Colores, tipografía y estilos compartidos por todas las ventanas. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta -->
    <SolidColorBrush x:Key="Primario" Color="#2457C5"/>
    <SolidColorBrush x:Key="PrimarioSuave" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="Texto" Color="#202938"/>
    <SolidColorBrush x:Key="TextoNormal" Color="#344054"/>
    <SolidColorBrush x:Key="TextoSecundario" Color="#667085"/>
    <SolidColorBrush x:Key="TextoTenue" Color="#98A2B3"/>
    <SolidColorBrush x:Key="Borde" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="BordeControl" Color="#D0D5DD"/>
    <SolidColorBrush x:Key="Fondo" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="Superficie" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hover" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="Peligro" Color="#B42318"/>
    <SolidColorBrush x:Key="PeligroSuave" Color="#FEF3F2"/>
    <SolidColorBrush x:Key="Exito" Color="#027A48"/>
    <SolidColorBrush x:Key="ExitoSuave" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="Carpeta" Color="#D99A06"/>
    <SolidColorBrush x:Key="Encabezado" Color="#1B2433"/>

    <!-- Iconos de Windows 11 (con respaldo para Windows 10) -->
    <FontFamily x:Key="Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Monoespaciada">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Icono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextoTenue}"/>
    </Style>

    <!-- Botón base: esquinas redondeadas y una capa que oscurece al pasar el mouse,
         así cualquier color de fondo tiene estados hover y presionado. -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoNormal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <Border x:Name="Capa"
                                Background="Black"
                                CornerRadius="6"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Capa" Property="Opacity" Value="0.05"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Capa" Property="Opacity" Value="0.11"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource Primario}"/>
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BotonBase}"/>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Primario}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Foreground" Value="{StaticResource Peligro}"/>
    </Style>

    <Style x:Key="BotonPeligroLleno" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Peligro}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Botón transparente solo con icono (barra de navegación). -->
    <Style x:Key="BotonIcono" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Botón plano alineado a la izquierda (menú lateral y migas de pan). -->
    <Style x:Key="BotonPlano" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- Caja de texto con borde redondeado y foco visible. -->
    <Style x:Key="CajaTexto" TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Primario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Encabezados de columna planos, con borde inferior y redimensionables. -->
    <Style x:Key="EncabezadoColumna" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid Background="Transparent">
                        <Border BorderBrush="{StaticResource Borde}"
                                BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper"
                               HorizontalAlignment="Right"
                               Width="6"
                               Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila de la lista con hover y selección redondeados. -->
    <Style x:Key="FilaLista" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Fondo"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="0,7"
                            Margin="0,1">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PrimarioSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etiqueta pequeña con fondo (bloques, permisos). -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimarioSuave}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Encabezado}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource Primario}"/>
        <Setter Property="Background" Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
