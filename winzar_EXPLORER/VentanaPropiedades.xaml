<Window x:Class="winzar_EXPLORER.VentanaPropiedades"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Propiedades"
        SizeToContent="Height"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Superficie}">

    <Window.Resources>
        <Style x:Key="Clave" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <StackPanel Margin="24,22,24,0">
            <DockPanel Margin="0,0,0,18">
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10"
                        Background="{StaticResource PrimarioSuave}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE8A5;" FontSize="20"
                               HorizontalAlignment="Center" Foreground="{StaticResource Primario}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitulo" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtRuta" FontSize="12" Foreground="{StaticResource TextoSecundario}"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tamaño" Style="{StaticResource Clave}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTamaño" Style="{StaticResource Valor}"/>
                <TextBlock Grid.Row="1" Text="Espacio en disco" Style="{StaticResource Clave}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtEspacio" Style="{StaticResource Valor}"/>
                <TextBlock Grid.Row="2" Text="Bloques" Style="{StaticResource Clave}"/>
                <WrapPanel Grid.Row="2" Grid.Column="1" x:Name="PanelBloques" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="3" Text="Creado" Style="{StaticResource Clave}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtCreado" Style="{StaticResource Valor}"/>
                <TextBlock Grid.Row="4" Text="Modificado" Style="{StaticResource Clave}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtModificado" Style="{StaticResource Valor}"/>
            </Grid>

            <Border Height="1" Background="{StaticResource Borde}" Margin="0,10,0,16"/>

            <TextBlock Text="PERMISOS" Style="{StaticResource Etiqueta}" Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkLectura">
                <TextBlock>
                    <Run Text="Lectura (r)" FontWeight="SemiBold"/>
                    <Run Text=" — abrir y ver el contenido" Foreground="{StaticResource TextoSecundario}"/>
                </TextBlock>
            </CheckBox>
            <CheckBox x:Name="ChkEscritura">
                <TextBlock>
                    <Run Text="Escritura (w)" FontWeight="SemiBold"/>
                    <Run Text=" — modificar el contenido" Foreground="{StaticResource TextoSecundario}"/>
                </TextBlock>
            </CheckBox>
            <CheckBox x:Name="ChkEliminacion">
                <TextBlock>
                    <Run Text="Eliminación (d)" FontWeight="SemiBold"/>
                    <Run Text=" — borrar el archivo" Foreground="{StaticResource TextoSecundario}"/>
                </TextBlock>
            </CheckBox>
        </StackPanel>

        <Border Background="{StaticResource Fondo}"
                BorderBrush="{StaticResource Borde}"
                BorderThickness="0,1,0,0"
                Padding="24,12"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Guardar permisos"
                        Style="{StaticResource BotonPrimario}"
                        IsDefault="True"
                        Click="Guardar_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
