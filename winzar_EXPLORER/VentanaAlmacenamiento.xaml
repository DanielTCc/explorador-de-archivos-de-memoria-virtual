<Window x:Class="winzar_EXPLORER.VentanaAlmacenamiento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapa de bloques"
        Height="700"
        Width="900"
        MinHeight="460"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Fondo}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                    Background="{StaticResource PrimarioSuave}" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource Icono}" Text="&#xEDA2;" FontSize="18"
                           HorizontalAlignment="Center" Foreground="{StaticResource Primario}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mapa de bloques del disco virtual" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource Texto}"/>
                <TextBlock x:Name="TxtResumen" FontSize="12" Foreground="{StaticResource TextoSecundario}"/>
            </StackPanel>
        </DockPanel>

        <!-- Indicadores -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <UniformGrid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Superficie}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="14,10"/>
                    <Setter Property="Margin" Value="0,0,10,0"/>
                </Style>
            </UniformGrid.Resources>
            <Border>
                <StackPanel>
                    <TextBlock Text="BLOQUES TOTALES" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="TxtTotal" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Texto}"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="OCUPADOS" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="TxtOcupados" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Primario}"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="LIBRES" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="TxtLibres" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Exito}"/>
                </StackPanel>
            </Border>
            <Border Margin="0">
                <StackPanel>
                    <TextBlock Text="USO DEL DISCO" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="TxtUso" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Texto}"/>
                    <ProgressBar x:Name="BarraUso" Maximum="100" Height="5" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Superficie}"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,10,0,0">
                        <Border Width="12" Height="12" CornerRadius="3" Background="#EEF1F5" Margin="0,0,6,0"/>
                        <TextBlock Text="Libre" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,0,16,0"/>
                        <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Primario}" Margin="0,0,6,0"/>
                        <TextBlock Text="Ocupado (un color por archivo)" FontSize="12" Foreground="{StaticResource TextoSecundario}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="GrillaBloques" Columns="10" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource Superficie}"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ARCHIVOS Y SUS BLOQUES" Style="{StaticResource Etiqueta}"
                               Margin="4,2,0,4"/>
                    <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource TextoTenue}"
                               TextWrapping="Wrap" Margin="4,0,0,10"
                               Text="Pasa el mouse sobre un archivo para resaltar sus bloques; haz clic para fijarlo."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelLeyenda"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
