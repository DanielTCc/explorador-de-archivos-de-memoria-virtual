<Window x:Class="winzar_EXPLORER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winzard Explorer"
        Height="780"
        Width="1380"
        MinHeight="600"
        MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fondo}"
        AllowDrop="True"
        DragOver="Ventana_DragOver"
        Drop="Ventana_Drop"
        PreviewKeyDown="Ventana_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Encabezado: marca, búsqueda y accesos -->
        <Border Grid.Row="0" Background="{StaticResource Encabezado}" Padding="18,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Primario}" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xEDA2;" FontSize="17"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Winzard Explorer" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Sistema de archivos virtual" Foreground="#9AA6B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="340" Margin="0,0,12,0">
                        <TextBox x:Name="CajaBusqueda"
                                 Style="{StaticResource CajaTexto}"
                                 Background="#2A3445"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderBrush="#3A4659"
                                 Padding="26,7,10,7"
                                 TextChanged="CajaBusqueda_TextChanged"/>
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE721;" Foreground="#9AA6B8"
                                   Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock Text="Buscar en todo el disco  (Ctrl+F)"
                                   Foreground="#7F8A9C"
                                   FontSize="13"
                                   Margin="33,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CajaBusqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Style="{StaticResource BotonPlano}"
                            Foreground="White"
                            Padding="12,8"
                            ToolTip="Abrir la terminal de comandos (Ctrl+T)"
                            Click="Terminal_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE756;" Margin="0,0,8,0"/>
                            <TextBlock Text="Terminal"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource BotonIcono}"
                            Foreground="White"
                            Content="&#xE946;"
                            ToolTip="Información y atajos de teclado (F1)"
                            Click="Informacion_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navegación: inicio, subir y migas de pan -->
        <Border Grid.Row="1"
                Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource Borde}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE80F;"
                            ToolTip="Ir a la raíz (Alt+Inicio)" Click="Raiz_Click"/>
                    <Button x:Name="BtnSubir" Style="{StaticResource BotonIcono}" Content="&#xE74A;"
                            ToolTip="Subir un nivel (Retroceso)" Click="Subir_Click"/>
                    <Button Style="{StaticResource BotonIcono}" Content="&#xE72C;" Margin="0,0,10,0"
                            ToolTip="Actualizar (F5)" Click="Actualizar_Click"/>
                </StackPanel>

                <Border Background="{StaticResource Fondo}" CornerRadius="6" Padding="4,2">
                    <StackPanel x:Name="PanelMigas" Orientation="Horizontal" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Panel lateral: árbol de carpetas y uso del disco -->
            <Border Grid.Column="0"
                    Background="{StaticResource Superficie}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    Margin="0,0,14,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource Borde}"
                            BorderThickness="0,1,0,0"
                            Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource Etiqueta}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtUsoDisco" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Texto}"/>
                            <ProgressBar x:Name="BarraDisco" Maximum="100" Margin="0,8,0,6"/>
                            <TextBlock x:Name="TxtUsoBytes" FontSize="12"
                                       Foreground="{StaticResource TextoSecundario}"/>
                            <Button Style="{StaticResource BotonPlano}"
                                    Foreground="{StaticResource Primario}"
                                    Padding="0,8,0,0"
                                    ToolTip="Ver qué bloques usa cada archivo"
                                    Click="Almacenamiento_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE8A9;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ver mapa de bloques" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="CARPETAS" Style="{StaticResource Etiqueta}"
                               Margin="16,16,0,8"/>

                    <TreeView x:Name="ArbolCarpetas"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="6,0,6,8"
                              SelectedItemChanged="ArbolCarpetas_SelectedItemChanged">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EAF1FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#2457C5"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EAF1FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#2457C5"/>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Contenido del directorio -->
            <Border Grid.Column="1"
                    Background="{StaticResource Superficie}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    Padding="20,18,20,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtTituloCarpeta" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource Texto}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtResumenCarpeta" FontSize="13" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextoSecundario}"/>
                    </StackPanel>

                    <!-- Aviso de modo búsqueda -->
                    <Border x:Name="PanelBusqueda"
                            Grid.Row="1"
                            Background="{StaticResource PrimarioSuave}"
                            CornerRadius="6"
                            Padding="12,6"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource BotonPlano}"
                                    Foreground="{StaticResource Primario}"
                                    Padding="8,4"
                                    Content="Cerrar búsqueda (Esc)"
                                    Click="CerrarBusqueda_Click"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE721;"
                                           Foreground="{StaticResource Primario}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtBusqueda" Foreground="{StaticResource Primario}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Acciones -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource BotonBase}">
                                <Setter Property="Margin" Value="0,0,6,6"/>
                                <Setter Property="Padding" Value="12,7"/>
                            </Style>
                        </WrapPanel.Resources>

                        <Button Style="{StaticResource BotonPrimario}" Margin="0,0,6,6" Padding="12,7"
                                ToolTip="Ctrl+N" Click="CrearArchivo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" Margin="0,0,8,0"/>
                                <TextBlock Text="Nuevo archivo"/>
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Ctrl+Mayús+N" Click="CrearCarpeta_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE8F4;" Margin="0,0,8,0"
                                           Foreground="{StaticResource Carpeta}"/>
                                <TextBlock Text="Nueva carpeta"/>
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Importar un archivo de texto del equipo (también puedes arrastrarlo aquí)"
                                Click="ImportarArchivo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE8B5;" Margin="0,0,8,0"/>
                                <TextBlock Text="Importar"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="22" Background="{StaticResource Borde}" Margin="4,0,12,6"/>

                        <Button x:Name="BtnEditar" ToolTip="Ctrl+E" Click="EditarArchivo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE70F;" Margin="0,0,8,0"/>
                                <TextBlock Text="Editar"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPropiedades" ToolTip="Alt+Entrar" Click="Propiedades_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE946;" Margin="0,0,8,0"/>
                                <TextBlock Text="Propiedades"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnEliminar" Style="{StaticResource BotonPeligro}" Margin="0,0,6,6" Padding="12,7"
                                ToolTip="Supr" Click="Eliminar_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icono}" Text="&#xE74D;" Margin="0,0,8,0"/>
                                <TextBlock Text="Eliminar"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Lista detallada -->
                    <Grid Grid.Row="3">
                        <ListView x:Name="ListaArchivos"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="13"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{StaticResource FilaLista}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="Abrir_Click"
                                  SelectionChanged="ListaArchivos_SelectionChanged"
                                  KeyDown="ListaArchivos_KeyDown"
                                  ContextMenuOpening="ListaArchivos_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuAbrir" Header="Abrir" InputGestureText="Entrar" Click="Abrir_Click"/>
                                    <MenuItem x:Name="MenuEditar" Header="Editar" InputGestureText="Ctrl+E" Click="EditarArchivo_Click"/>
                                    <MenuItem x:Name="MenuPropiedades" Header="Propiedades" InputGestureText="Alt+Entrar" Click="Propiedades_Click"/>
                                    <MenuItem x:Name="MenuMapa" Header="Ver sus bloques en el mapa" Click="VerEnMapa_Click"/>
                                    <MenuItem x:Name="MenuEliminar" Header="Eliminar" InputGestureText="Supr" Click="Eliminar_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Nuevo archivo" InputGestureText="Ctrl+N" Click="CrearArchivo_Click"/>
                                    <MenuItem Header="Nueva carpeta" InputGestureText="Ctrl+Mayús+N" Click="CrearCarpeta_Click"/>
                                    <MenuItem Header="Importar archivo..." Click="ImportarArchivo_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>

                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource EncabezadoColumna}">
                                    <GridViewColumn Header="Nombre" Width="250">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icono}" Text="{Binding Icono}"
                                                               Foreground="{Binding ColorIcono}" FontSize="16"
                                                               Margin="2,0,10,0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Ruta}" FontSize="11"
                                                                   Foreground="{StaticResource TextoTenue}"
                                                                   Visibility="{Binding VisibilidadRuta}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Tamaño" Width="95">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Tamaño}" Foreground="{StaticResource TextoSecundario}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Bloques" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Bloques}" Foreground="{StaticResource TextoSecundario}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Permisos" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Permisos}" FontFamily="{StaticResource Monoespaciada}"
                                                           Foreground="{StaticResource TextoSecundario}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modificado" Width="125">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Fecha}" Foreground="{StaticResource TextoSecundario}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Estado vacío -->
                        <StackPanel x:Name="PanelVacio"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Fondo}"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtVacioIcono" Style="{StaticResource Icono}" FontSize="26"
                                           Foreground="{StaticResource TextoTenue}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtVacioTitulo" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextoNormal}" HorizontalAlignment="Center"
                                       Margin="0,12,0,4"/>
                            <TextBlock x:Name="TxtVacioDetalle" FontSize="13" Foreground="{StaticResource TextoSecundario}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Panel de detalles del elemento seleccionado -->
            <Border Grid.Column="2"
                    Background="{StaticResource Superficie}"
                    CornerRadius="10"
                    BorderBrush="{StaticResource Borde}"
                    BorderThickness="1"
                    Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelDetalles" Margin="18"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra de estado: notificación de la última operación y resumen -->
        <Border Grid.Row="3"
                Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource Borde}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <DockPanel>
                <TextBlock x:Name="TxtEstado"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource TextoSecundario}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel x:Name="PanelNotificacion" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNotificacionIcono" Style="{StaticResource Icono}" FontSize="13"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtNotificacion" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
