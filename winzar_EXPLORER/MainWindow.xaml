<Window x:Class="winzar_EXPLORER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winzard Explorer"
        Height="720"
        Width="1150"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="#202938"
                Padding="22,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="📁"
                           FontSize="30"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Winzard Explorer"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Sistema de archivos virtual"
                               Foreground="#B9C4D5"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Navegación -->
        <Border Grid.Row="1"
                Background="White"
                Padding="16,8"
                BorderBrush="#E1E6EE"
                BorderThickness="0,0,0,1">

            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <Button Content="⌂"
                            Width="38"
                            Height="32"
                            Padding="0"
                            FontSize="18"
                            Click="Raiz_Click"/>

                    <Button Content="↑"
                            Width="38"
                            Height="32"
                            Padding="0"
                            FontSize="18"
                            Margin="0,0,12,0"
                            Click="Subir_Click"/>
                </StackPanel>

                <TextBox x:Name="TxtRuta"
                         Text="/"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Padding="12,4"
                         Background="#F3F5F9"
                         BorderThickness="0"
                         FontSize="14"
                         Foreground="#344054"/>
            </DockPanel>
        </Border>

        <!-- Área principal -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel lateral -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,14,0">

                <StackPanel>
                    <TextBlock Text="UBICACIONES"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#7B8494"
                               Margin="8,8,0,14"/>

                    <Button Content="📁  Raíz"
                            HorizontalContentAlignment="Left"
                            Background="#EAF1FF"
                            Foreground="#2457C5"
                            BorderThickness="0"
                            Click="Raiz_Click"/>

                    <Button Content="💾  Almacenamiento"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"
                            Click="Almacenamiento_Click"/>

                    <Button Content="ℹ️  Información"
                            HorizontalContentAlignment="Left"
                            BorderThickness="0"
                            Click="Informacion_Click"/>
                </StackPanel>
            </Border>

            <!-- Panel de archivos -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="22">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Archivos y carpetas"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#202938"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Administra el contenido de tu disco virtual."
                                   FontSize="13"
                                   Foreground="#7B8494"
                                   Margin="0,0,0,18"/>
                    </StackPanel>

                    <!-- Acciones -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                        <Button Content="＋ Carpeta"
                                Background="#2457C5"
                                Foreground="White"
                                BorderThickness="0"
                                Click="CrearCarpeta_Click"/>

                        <Button Content="＋ Archivo"
                                Click="CrearArchivo_Click"/>

                        <Button Content="Eliminar"
                                Foreground="#B42318"
                                Click="Eliminar_Click"/>
                        
                        <Button Content="Importar archivo"
                                Click="ImportarArchivo_Click"/>
                    </WrapPanel>

                    <!-- Lista real -->
                    <Border Grid.Row="2"
                            BorderBrush="#E1E6EE"
                            BorderThickness="1"
                            CornerRadius="8">

                        <Grid>
                            <ListView x:Name="ListaArchivos"
                                      BorderThickness="0"
                                      Background="White"
                                      FontSize="14"
                                      Padding="6"
                                      MouseDoubleClick="Abrir_Click">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="8,9"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment"
                                                Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>

                            <TextBlock Text="Esta carpeta está vacía"
                                       Foreground="#98A2B3"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding ElementName=ListaArchivos, Path=HasItems}"
                                                Value="False">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E1E6EE"
                BorderThickness="0,1,0,0"
                Padding="16,0">

            <TextBlock x:Name="TxtEstado"
                       Text="0 elementos | Bloques libres: 100/100"
                       Foreground="#667085"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>