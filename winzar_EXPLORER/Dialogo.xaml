<Window x:Class="winzar_EXPLORER.Dialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Superficie}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,22,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FondoIcono"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="{StaticResource PrimarioSuave}"
                    VerticalAlignment="Top"
                    Margin="0,0,14,0">
                <TextBlock x:Name="TxtIcono"
                           Style="{StaticResource Icono}"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource Primario}"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TxtTitulo"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Texto}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="TxtMensaje"
                           FontSize="13"
                           Foreground="{StaticResource TextoSecundario}"
                           TextWrapping="Wrap"
                           LineHeight="19"/>

                <TextBox x:Name="TxtEntrada"
                         Style="{StaticResource CajaTexto}"
                         Margin="0,12,0,0"
                         Visibility="Collapsed"
                         TextChanged="TxtEntrada_TextChanged"/>

                <TextBlock x:Name="TxtError"
                           FontSize="12"
                           Foreground="{StaticResource Peligro}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource Fondo}"
                BorderBrush="{StaticResource Borde}"
                BorderThickness="0,1,0,0"
                Padding="22,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelar"
                        Content="Cancelar"
                        IsCancel="True"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnAceptar"
                        Style="{StaticResource BotonPrimario}"
                        IsDefault="True"
                        MinWidth="90"
                        Click="Aceptar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
