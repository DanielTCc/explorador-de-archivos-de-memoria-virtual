<Window x:Class="winzar_EXPLORER.VentanaTerminal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal - Winzard Explorer"
        Height="560"
        Width="800"
        MinHeight="320"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#161B25">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior con ayuda rápida -->
        <Border Grid.Row="0" Background="#1E2533" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="Tab completa · ↑ ↓ historial · Ctrl+L limpia · Esc borra la línea"
                           Foreground="#7F8A9C"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE756;" Foreground="#7CC4FF" Margin="0,0,8,0"/>
                    <TextBlock Text="Terminal del sistema de archivos virtual" Foreground="#D7DEE8"
                               FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBox x:Name="TxtSalida"
                 Grid.Row="1"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="Transparent"
                 Foreground="#D7DEE8"
                 BorderThickness="0"
                 Padding="14,10"
                 FontFamily="{StaticResource Monoespaciada}"
                 FontSize="14"/>

        <Border Grid.Row="2" Background="#1E2533" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="TxtPrompt"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#7CC4FF"
                           FontFamily="{StaticResource Monoespaciada}"
                           FontSize="14"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="TxtComando"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         Padding="0,4"
                         FontFamily="{StaticResource Monoespaciada}"
                         FontSize="14"
                         PreviewKeyDown="TxtComando_PreviewKeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
